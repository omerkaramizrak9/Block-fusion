{
  "name": "block-fusion",
  "version": "0.2.0",
  "private": true,
  "description": "MAJOR BLOCK – Android ve iOS için blok bulmaca oyunu (tek kod tabanı)",
  "scripts": {
    "serve": "npx --yes http-server www -p 8080 -c-1",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "assets": "capacitor-assets generate --android --ios --iconBackgroundColor '#0b1638' --splashBackgroundColor '#0b1638'",
    "sync": "cap sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2"
  }
}
